# Copia este archivo a ".env" y ajusta los valores. NUNCA subas ".env" a un repositorio.

# --- Servidor ----------------------------------------------------------------
# HOST debe ser 127.0.0.1, localhost o ::1, salvo con el acceso desde el aula activo (ver abajo).
HOST=127.0.0.1
PORT=3000

# --- Acceso desde la red del aula ------------------------------------------
# Desactivado por defecto. Actívalo solo durante la práctica, en la red del aula.
# Con LAB_LAN_ENABLED=true:
#   - HOST debe ser la IPv4 concreta de tu tarjeta de red (nunca 0.0.0.0).
#     Consúltala con:  ip -4 -br addr show
#   - LAB_ALLOWED_CLIENTS es obligatorio: subred del aula o IPs concretas, separadas por comas.
#     Prefijo mínimo /16. Cualquier otra IP recibe un 403.
# Ejemplo (aula con red 172.29.230.128/25):
#   LAB_LAN_ENABLED=true
#   HOST=172.29.230.189
#   LAB_ALLOWED_CLIENTS=172.29.230.128/25
LAB_LAN_ENABLED=false
LAB_ALLOWED_CLIENTS=

# --- MySQL / MariaDB (XAMPP) -------------------------------------------------
# XAMPP trae por defecto: usuario root, sin contraseña, puerto 3306.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cybershop
DB_CONNECTION_LIMIT=10

# --- Sesiones ------------------------------------------------------------------
# Cadena larga y aleatoria. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
